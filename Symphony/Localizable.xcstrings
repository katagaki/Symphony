        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta tu cuenta de App Store Connect para gestionar las compilaciones de Xcode Cloud. Tu clave API debe tener permisos de administrador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez votre compte App Store Connect pour gérer les builds Xcode Cloud. Votre clé API doit disposer des autorisations d’administrateur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect アカウントを接続して Xcode Cloud のビルドを管理します。API キーには管理者権限が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect 계정을 연결하여 Xcode Cloud 빌드를 관리하세요. API 키에 관리자 권한이 있어야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接你的 App Store Connect 账户以管理 Xcode Cloud 构建。你的 API 密钥需要具有管理员权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連接你的 App Store Connect 帳號以管理 Xcode Cloud 建置。你的 API 金鑰需要具有管理員權限。"
          }
        }
      }
