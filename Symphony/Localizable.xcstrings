    "Onboarding.Description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinden Sie Ihren App Store Connect-Account, um Xcode Cloud-Builds zu verwalten. Ihr API-Schlüssel muss über Administratorrechte verfügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect your App Store Connect account to manage Xcode Cloud builds. Your API key should have Admin permissions."
