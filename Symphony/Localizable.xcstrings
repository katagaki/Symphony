    "Accounts.Footer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie ein Konto aus, um dessen Anmeldedaten zu verwenden. Streichen Sie, um ein Konto zu löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select an account to use its credentials. Swipe to delete an account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona una cuenta para usar sus credenciales. Desliza para eliminar una cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez un compte pour utiliser ses identifiants. Balayez pour supprimer un compte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "認証情報を使用するアカウントを選択します。スワイプしてアカウントを削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자격 증명을 사용할 계정을 선택하세요. 계정을 삭제하려면 쓸어넘기세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一个账户以使用其凭证。滑动以删除账户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇一個帳號以使用其憑證。滑動以刪除帳號。"
          }
        }
      }
    },
